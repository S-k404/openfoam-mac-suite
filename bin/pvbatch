#!/usr/bin/env bash
# ==============================================================================
# pvbatch - macOS ParaView Batch MPI Wrapper
# ==============================================================================
PVBATCH_BIN=""
if [ -n "${PARAVIEW_APP:-}" ] && [ -x "${PARAVIEW_APP}/Contents/bin/pvbatch" ]; then
    PVBATCH_BIN="${PARAVIEW_APP}/Contents/bin/pvbatch"
elif [ -x "/Applications/ParaView.app/Contents/bin/pvbatch" ]; then
    PVBATCH_BIN="/Applications/ParaView.app/Contents/bin/pvbatch"
else
    for app in $(ls -1dr /Applications/ParaView*.app 2>/dev/null); do
        if [ -x "$app/Contents/bin/pvbatch" ]; then
            PVBATCH_BIN="$app/Contents/bin/pvbatch"
            break
        fi
    done
fi

if [ ! -x "$PVBATCH_BIN" ]; then
    echo "Error: pvbatch not found in /Applications/ParaView*.app" >&2
    exit 1
fi

exec "$PVBATCH_BIN" "$@"
