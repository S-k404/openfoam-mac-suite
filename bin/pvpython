#!/usr/bin/env bash
# ==============================================================================
# pvpython - macOS ParaView Python Wrapper
# ==============================================================================
PVPYTHON_BIN=""
if [ -n "${PARAVIEW_APP:-}" ] && [ -x "${PARAVIEW_APP}/Contents/bin/pvpython" ]; then
    PVPYTHON_BIN="${PARAVIEW_APP}/Contents/bin/pvpython"
elif [ -x "/Applications/ParaView.app/Contents/bin/pvpython" ]; then
    PVPYTHON_BIN="/Applications/ParaView.app/Contents/bin/pvpython"
else
    for app in $(ls -1dr /Applications/ParaView*.app 2>/dev/null); do
        if [ -x "$app/Contents/bin/pvpython" ]; then
            PVPYTHON_BIN="$app/Contents/bin/pvpython"
            break
        fi
    done
fi

if [ ! -x "$PVPYTHON_BIN" ]; then
    echo "Error: pvpython not found in /Applications/ParaView*.app" >&2
    exit 1
fi

exec "$PVPYTHON_BIN" "$@"
